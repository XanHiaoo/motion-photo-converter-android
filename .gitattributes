# Keep text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows scripts are conventionally stored with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files must not be modified by line-ending conversion.
*.apk binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.mov binary
*.heic binary
*.pdf binary
