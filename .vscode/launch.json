{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: Chrome (start Vite manually)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173/samsung-motion-photo-tool/",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Web: Chrome (start Vite automatically)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173/samsung-motion-photo-tool/",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "web:dev",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
