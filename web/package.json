{
  "name": "motion-photo-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --base /assets/ --outDir ../app/src/main/assets --emptyOutDir",
