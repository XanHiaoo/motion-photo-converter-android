.home-page {
  width: 100%;
  max-width: 785rpx;
  min-height: 100vh;
  margin: 0 auto;
  padding-right: 40rpx;
  padding-left: 40rpx;
  display: flex;
  flex-direction: column;
  background: #f3f5f8;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  width: 73rpx;
  height: 73rpx;
  flex: 0 0 auto;
}

.brand-name {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 13rpx;
  color: #18304f;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.045em;
  white-space: nowrap;
}

.brand-main {
  color: #18304f;
}

.brand-sub {
  color: #4e7fcf;
  font-weight: 550;
}

.home-intro {
  margin: 88rpx 0 60rpx;
  display: flex;
  flex-direction: column;
}

.home-title {
  color: #182b45;
  font-size: 57rpx;
  font-weight: 750;
  line-height: 1.4;
  letter-spacing: -0.07em;
}

.home-subtitle {
  margin-top: 15rpx;
  color: #788394;
  font-size: 22rpx;
  line-height: 1.7;
}

.section-label {
  margin: 0 5rpx 20rpx;
  color: #8090a3;
  font-size: 18rpx;
  line-height: 1.4;
}

.home-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.home-secondary-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.home-card {
  position: relative;
  box-sizing: border-box;
  padding: 27rpx;
  border: 0;
  border-radius: 31rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  color: #182b45;
  text-align: left;
  line-height: 1.4;
  background: #fff;
}

.home-card-primary {
  width: 100%;
  flex: 0 0 100%;
  min-height: 259rpx;
  padding: 36rpx 29rpx;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  color: #fff;
  background: #4e7fcf;
}

.card-primary-hover {
  background: #4776c0;
}

.card-hover {
  background: #f9fbff;
}

.home-card-secondary {
  width: 48.5%;
  min-width: 0;
  flex: 0 0 48.5%;
  min-height: 230rpx;
  padding: 27rpx;
}

.home-card-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-icon {
  background: rgba(255, 255, 255, 0.16);
}

.secondary-icon-green {
  background: #edf5f1;
}

.secondary-icon-purple {
  background: #f4f0f9;
}

.home-card-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.primary-copy {
  flex: 1;
  padding-right: 47rpx;
}

.home-card-title {
  max-width: 100%;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.home-card-subtitle {
  max-width: 100%;
  color: #8490a0;
  font-size: 18rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.primary-copy .home-card-title {
  color: #fff;
  font-size: 31rpx;
}

.primary-copy .home-card-subtitle {
  color: #edf3ff;
}

.secondary-title {
  margin-top: 18rpx;
  font-size: 24rpx;
  letter-spacing: -0.03em;
  white-space: nowrap;
}

.secondary-subtitle {
  white-space: nowrap;
}

.home-chevron {
  position: absolute;
  right: 25rpx;
}

.primary-chevron {
  right: 29rpx;
  top: 50%;
  transform: translateY(-50%);
}

.secondary-chevron {
  top: 29rpx;
}

.home-bottom-meta {
  margin: auto 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  color: #8b958e;
  font-size: 18rpx;
  line-height: 1.4;
}
