<view class="video-page" style="padding-top: {{insets.videoTopRpx}}rpx; padding-bottom: {{insets.videoBottomRpx}}rpx;">
  <view class="mode-header">
    <view class="back-button" hover-class="back-button-hover" bindtap="goBack" aria-label="返回首页">
      <ui-icon name="arrow-left" size="21" />
    </view>
    <text class="mode-title">视频生成 Motion Photo</text>
  </view>

  <view class="privacy-note">
    <ui-icon name="lock-muted" size="16" />
    <text>仅在本机处理，不会上传</text>
  </view>

  <view class="section-heading">
    <text>选择片段和封面，生成 Samsung Motion Photo。</text>
  </view>

  <view wx:if="{{!video}}" class="upload-zone" hover-class="upload-zone-hover" bindtap="onChooseVideo">
    <view class="upload-icon"><ui-icon name="film-muted" size="25" /></view>
    <text class="upload-title">{{picking ? '正在打开视频' : '选择一个视频'}}</text>
    <text class="upload-caption">MP4 / MOV · 仅本机处理</text>
  </view>

  <view wx:else class="upload-zone is-compact" hover-class="upload-zone-hover" bindtap="onChooseVideo">
    <view class="upload-icon"><ui-icon name="film-muted" size="23" /></view>
    <text class="upload-title">{{picking ? '正在打开视频' : '更换视频'}}</text>
    <text class="upload-caption">{{video.name}} · {{video.sizeLabel}}</text>
  </view>

  <view wx:if="{{video}}" class="frame-card">
    <view class="frame-heading">
      <text class="frame-heading-title">选择视频片段</text>
      <text class="frame-heading-time">{{video.durationLabel}}</text>
    </view>

    <view class="frame-preview-stage">
      <video
        id="source-video"
        class="frame-preview"
        src="{{video.path}}"
        controls="{{false}}"
        show-center-play-btn="{{false}}"
        show-play-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        muted="{{true}}"
        loop="{{false}}"
        object-fit="contain"
        binderror="onVideoError"
      />
      <image wx:if="{{coverPreviewPath}}" class="frame-cover-preview" src="{{coverPreviewPath}}" mode="aspectFit" />
    </view>

    <view class="frame-slider-summary">
      <text>拖动选择封面</text>
      <text class="frame-slider-current">{{coverTimeLabel}}</text>
    </view>
    <slider
      class="frame-slider"
      min="0"
      max="{{sliderMaxSeconds}}"
      step="0.05"
      value="{{flow.coverTimeSeconds}}"
      block-size="20"
      activeColor="#2869e8"
      backgroundColor="#e8edf3"
      disabled="{{capturingCover}}"
      bindchange="onCoverChange"
    />
    <view class="frame-slider-labels">
      <text>起点 00:00.0</text>
      <text>全片 {{video.durationLabel}}</text>
    </view>

    <view wx:if="{{capturingCover}}" class="progress-card">
      <view class="progress-indicator"></view>
      <view class="progress-copy">
        <text class="progress-title">正在提取封面帧</text>
        <text class="progress-detail">{{coverTimeLabel}} · 请稍候</text>
      </view>
    </view>
    <view wx:if="{{coverError}}" class="error-card">
      <view class="error-mark">!</view>
      <text>{{coverError}}</text>
    </view>
  </view>

  <view wx:if="{{showJpegResult}}" class="jpeg-result-card">
    <view class="jpeg-result-heading">
      <view class="success-mark">✓</view>
      <view class="jpeg-result-copy">
        <text class="jpeg-result-title">封面 JPEG 已生成</text>
        <text class="jpeg-result-detail">{{coverFrameInfo.width}} × {{coverFrameInfo.height}} · {{coverTimeLabel}}</text>
      </view>
      <text class="jpeg-result-format">JPEG</text>
    </view>
    <image class="jpeg-result-image" src="{{flow.outputPath}}" mode="aspectFit" bindtap="onPreviewJpeg" />
    <view class="jpeg-result-preview" hover-class="jpeg-result-preview-hover" bindtap="onPreviewJpeg">点按预览封面</view>
  </view>

  <canvas id="frame-source-canvas" type="2d" class="export-canvas"></canvas>
  <canvas id="frame-output-canvas" type="2d" class="export-canvas"></canvas>

  <view class="bottom-action" style="bottom: {{insets.actionBottomRpx}}rpx;">
    <view wx:if="{{!video}}" class="primary-button is-disabled" aria-disabled="true">
      <ui-icon name="images-white" size="19" />
      <text>生成 Motion Photo</text>
    </view>
    <view wx:elif="{{showJpegResult}}" class="primary-button primary-button-hover" bindtap="onPreviewJpeg">
      <ui-icon name="images-white" size="19" />
      <text>预览封面 JPEG</text>
    </view>
    <view wx:else class="primary-button {{(!coverFrameInfo || capturingCover) ? 'is-disabled' : ''}}" aria-disabled="{{!coverFrameInfo || capturingCover}}" hover-class="primary-button-hover" bindtap="onGenerateCover">
      <ui-icon name="images-white" size="19" />
      <text>{{capturingCover ? '正在生成封面…' : '生成封面 JPEG'}}</text>
    </view>
  </view>
</view>